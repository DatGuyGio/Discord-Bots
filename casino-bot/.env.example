# Copy to .env and fill in. Never commit the real .env.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Prefix for the text-command versions of every command. Slash commands work
# regardless of this.
CASINO_PREFIX=!

# Where the SQLite database lives.
CASINO_DB=casino.sqlite3

# Optional: your own user id(s), space or comma separated. Owners bypass the
# staff checks and can use !sync.
CASINO_OWNER_IDS=

# Optional: while developing, set this to one server id. Slash commands sync to
# that server instantly instead of taking up to an hour to appear globally.
CASINO_DEV_GUILD=

# DEBUG, INFO, WARNING
CASINO_LOG_LEVEL=INFO
